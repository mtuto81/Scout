# Copy this to .env or export these variables in your shell.

# Online backend
SCOUT_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-4.5-air:free

# Local Ollama backend
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:latest
OLLAMA_API_KEY=ollama

# Optional model override for either backend
# AI_MODEL=

# In-app updater. Point this at a GitHub Release asset or raw JSON manifest.
# Example:
# SCOUT_UPDATE_MANIFEST_URL=https://github.com/OWNER/REPO/releases/latest/download/latest.json
SCOUT_UPDATE_MANIFEST_URL=
SCOUT_UPDATE_CHECK_INTERVAL_SECONDS=21600
